---
const { id, hidden } = Astro.props;
---

<section id={id} hidden={hidden} class="mx-auto flex min-h-[calc(100vh-7rem)] max-w-5xl flex-col px-4 py-5 sm:px-6 sm:py-8">
  <!-- Resumen de la conferencia activa -->
  <div class="relative mb-6 overflow-hidden rounded-[1.75rem] border border-border-main/80 bg-white shadow-custom">
    <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-navy via-turq-acc to-green"></div>
    <div class="flex flex-col gap-5 p-5 sm:flex-row sm:items-center sm:justify-between sm:px-7 sm:py-6">
      <div class="flex min-w-0 items-start gap-4">
        <div class="hidden size-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-navy to-[#0a6687] text-white shadow-md sm:flex" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="3.5" width="14" height="17" rx="2.5"></rect>
            <path d="M8.5 8h7M8.5 12h4"></path>
            <path d="m9 16 1.7 1.7L15 14.5"></path>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-2">
            <span id="kiosk-status" class="inline-flex items-center gap-2 rounded-full border border-green/20 bg-green-pale px-3 py-1 text-[11px] font-bold tracking-[0.12em] text-navy">
              <span class="size-1.5 rounded-full bg-green shadow-[0_0_0_3px_rgba(64,206,2,0.12)]"></span>
              REGISTRO ABIERTO
            </span>
            <span class="text-[10px] font-semibold uppercase tracking-[0.19em] text-text-muted">Conferencia activa</span>
          </div>
          <h2 id="kiosk-title" class="break-words font-stellalabs text-xl font-bold leading-tight tracking-tight text-navy sm:text-2xl">Cargando...</h2>
          <p class="mt-1.5 text-sm text-text-muted">Escanea una credencial para registrar la asistencia.</p>
        </div>
      </div>

      <div class="flex items-center justify-between gap-3 border-t border-border-lt pt-4 sm:justify-end sm:border-l sm:border-t-0 sm:pl-5 sm:pt-0">
        <div class="flex min-w-[132px] items-center gap-3 rounded-2xl border border-border-lt bg-bg-main/80 px-4 py-2.5">
          <div class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-turq-pale text-navy" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="10" cy="7" r="4"></circle>
              <path d="M20 8v6M17 11h6"></path>
            </svg>
          </div>
          <div>
            <p id="kiosk-count" class="font-stellalabs text-2xl font-bold leading-none tabular-nums text-navy" aria-live="polite">–</p>
            <p class="mt-1 text-[10px] font-bold uppercase tracking-[0.12em] text-text-muted">Asistentes</p>
          </div>
        </div>
        <button
          id="btn-end"
          type="button"
          class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-border-main bg-white px-4 py-3 text-sm font-bold text-text-mid transition-all hover:border-turq-acc hover:bg-turq-pale hover:text-navy focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-turq-acc/20"
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6"></path><path d="M9 12h11"></path>
          </svg>
          Volver
        </button>
      </div>
    </div>
  </div>

  <!-- Estado principal del lector -->
  <div class="flex flex-1 flex-col items-center justify-center pb-5">
    <div
      id="scan-feedback"
      role="status"
      aria-live="assertive"
      class="relative flex w-full max-w-4xl flex-col items-center gap-5 overflow-hidden rounded-[1.75rem] border border-border-main bg-white p-6 shadow-custom-lg transition-all duration-300 sm:flex-row sm:gap-7 sm:p-9"
    >
      <div class="pointer-events-none absolute inset-y-0 left-0 w-1.5 bg-gradient-to-b from-turq-acc via-navy to-green"></div>
      <div id="feedback-icon" class="relative z-10 flex size-20 shrink-0 items-center justify-center rounded-2xl bg-turq-pale text-navy shadow-[0_10px_24px_rgba(0,174,204,0.14)] sm:size-24" aria-hidden="true">
        <svg viewBox="0 0 48 48" class="size-11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="6.5" y="10" width="25" height="28" rx="5"></rect>
          <path d="M12 18h14M12 23h8M12 29h6"></path>
          <path d="M34 17c4.5 4 4.5 10 0 14M38 12c7 6 7 18 0 24"></path>
        </svg>
      </div>
      <div class="relative z-10 min-w-0 flex-1 text-center sm:text-left">
        <p class="mb-2 flex items-center justify-center gap-2 text-[10px] font-bold uppercase tracking-[0.2em] text-turq-acc sm:justify-start">
          <span class="size-1.5 rounded-full bg-turq-acc"></span>
          Estado del registro
        </p>
        <h3 id="feedback-title" class="font-stellalabs text-2xl font-bold leading-tight tracking-tight text-navy sm:text-3xl">Esperando credencial</h3>
        <p id="feedback-subtitle" class="mt-2 text-sm leading-relaxed text-text-mid sm:text-base">Acerca tu credencial al lector</p>
        <div class="mt-4 flex flex-wrap items-center justify-center gap-2 sm:justify-start">
          <span class="inline-flex items-center gap-2 rounded-full border border-border-lt bg-bg-main px-3 py-1.5 text-[11px] font-semibold text-text-mid">
            <svg viewBox="0 0 24 24" class="size-4 text-turq-acc" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3.5" y="5" width="11" height="14" rx="2"></rect><path d="M17 8c2 2 2 6 0 8M19.5 5.5c3.5 3.5 3.5 9.5 0 13"></path>
            </svg>
            Lectura automática
          </span>
          <span class="text-[11px] text-text-muted">La asistencia se valida en el sistema</span>
        </div>
      </div>
    </div>

    <!-- Alternativa de registro manual -->
    <form id="manual-form" class="mt-5 w-full max-w-4xl rounded-2xl border border-border-main/80 bg-white p-4 shadow-custom sm:p-5" autocomplete="off" novalidate>
      <div class="mb-4 flex flex-col gap-1.5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <label for="code-input" class="block text-sm font-bold text-navy">Registrar con código de estudiante</label>
          <p class="mt-1 text-xs text-text-muted">Utiliza esta opción si no tienes tu credencial a la mano.</p>
        </div>
        <span class="w-fit rounded-full bg-turq-pale px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.13em] text-navy">Entrada manual</span>
      </div>
      <div class="flex flex-col gap-2 sm:flex-row">
        <input
          id="code-input"
          type="text"
          inputmode="text"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          maxlength="20"
          placeholder="Escribe tu código"
          class="h-12 min-w-0 flex-1 rounded-xl border border-border-main bg-bg-main/60 px-4 font-mono text-base tracking-wider text-navy transition-all placeholder:font-poppins placeholder:text-sm placeholder:tracking-normal placeholder:text-text-muted hover:border-[#a9c2da] focus:border-turq-acc focus:bg-white focus:outline-none focus:ring-4 focus:ring-turq-acc/15"
        />
        <button
          type="submit"
          class="inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-xl bg-navy px-6 text-sm font-bold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-navy-mid hover:shadow-md focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-turq-acc/25"
        >
          Registrar
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </button>
      </div>
    </form>

    <!-- Estado del receptor y acciones -->
    <div class="mt-4 flex w-full max-w-4xl flex-col gap-3 rounded-2xl border border-border-lt bg-white/80 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-2.5">
        <span
          id="reader-dot"
          data-ready="false"
          class="size-2.5 shrink-0 rounded-full bg-text-muted/40 transition-colors data-[ready=true]:bg-green data-[ready=true]:ring-4 data-[ready=true]:ring-green/15"
        ></span>
        <div>
          <p id="reader-label" class="text-xs font-bold text-text-mid">Lector inactivo</p>
          <p class="mt-0.5 text-[10px] text-text-muted">Estado de conexión del lector USB</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button
          id="btn-nfc-phone"
          type="button"
          hidden
          data-active="false"
          class="inline-flex items-center justify-center rounded-xl border border-border-main bg-white px-3.5 py-2.5 text-xs font-semibold text-navy transition-colors hover:border-turq-acc hover:bg-turq-pale data-[active=true]:border-green/30 data-[active=true]:bg-green-pale data-[active=true]:text-navy focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-turq-acc/20"
        >
          Usar NFC del celular
        </button>
        <button
          id="btn-refocus"
          type="button"
          class="inline-flex items-center justify-center gap-2 rounded-xl px-3.5 py-2.5 text-xs font-bold text-text-mid transition-colors hover:bg-turq-pale hover:text-navy focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-turq-acc/20"
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 4H4v4M16 4h4v4M4 16v4h4M20 16v4h-4"></path><path d="M8 12h8M12 8v8"></path>
          </svg>
          Enfocar lector
        </button>
      </div>
    </div>

    <!-- Receptor oculto del lector USB; no mostrar el UID en pantalla. -->
    <input
      id="nfc-input"
      type="text"
      inputmode="none"
      autofocus
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      class="sr-only"
      aria-label="Lector de credencial NFC"
    />
  </div>
</section>

<script>
  import { supabase } from "../../lib/supabase";

  // ---------- Elementos ----------
  const section = document.getElementById("view-register")!;
  const reader = document.getElementById("nfc-input") as HTMLInputElement; // credencial (oculto)
  const codeInput = document.getElementById("code-input") as HTMLInputElement; // código manual (visible)
  const manualForm = document.getElementById("manual-form") as HTMLFormElement;
  const feedbackBox = document.getElementById("scan-feedback")!;
  const feedbackIcon = document.getElementById("feedback-icon")!;
  const feedbackTitle = document.getElementById("feedback-title")!;
  const feedbackSubtitle = document.getElementById("feedback-subtitle")!;
  const countEl = document.getElementById("kiosk-count")!;
  const readerDot = document.getElementById("reader-dot")!;
  const readerLabel = document.getElementById("reader-label")!;
  const btnRefocus = document.getElementById("btn-refocus")!;
  const btnNfcPhone = document.getElementById("btn-nfc-phone") as HTMLButtonElement;

  let activeConferenceId: number | null = null;
  let resetTimer: number;

  const esc = (s: unknown) =>
    String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

  // ---------- Foco: siempre regresa al receptor de la credencial ----------
  function pulseReady() {
    readerDot.classList.remove("animate-focus-ring");
    void readerDot.offsetWidth; // reinicia la animación
    readerDot.classList.add("animate-focus-ring");
  }

  function paintReader() {
    const ready = document.activeElement === reader;
    readerDot.dataset.ready = String(ready);
    readerLabel.textContent = ready ? "Lector listo" : "Lector inactivo";
  }

  function focusReader(flash = false) {
    if (section.hidden) return;
    if (document.activeElement !== reader) reader.focus({ preventScroll: true });
    paintReader();
    if (flash) pulseReady();
  }

  reader.addEventListener("focus", paintReader);
  reader.addEventListener("blur", () => {
    paintReader();
    // Si el usuario pasó al campo de código, respetarlo; en cualquier otro caso, recuperar el foco
    setTimeout(() => {
      if (section.hidden || document.activeElement === codeInput) return;
      const a = document.activeElement;
      if (!a || a === document.body) focusReader(true);
    }, 60);
  });

  codeInput.addEventListener("blur", () => {
    setTimeout(() => {
      const a = document.activeElement;
      if (!section.hidden && (!a || a === document.body)) focusReader(true);
    }, 100);
  });

  // Click en cualquier parte (salvo el formulario manual) devuelve el foco al lector
  document.addEventListener("click", (e) => {
    if (section.hidden) return;
    if ((e.target as Element).closest("#manual-form")) return;
    focusReader();
  });
  window.addEventListener("focus", () => focusReader(true)); // al volver a la pestaña
  btnRefocus.addEventListener("click", () => focusReader(true));

  // ---------- Contador (siempre desde la BD, por conferencia) ----------
  let countToken = 0;

  async function refreshCount(confId: number) {
    const token = ++countToken;
    const { count, error } = await supabase
      .from("conferences_attendance")
      .select("*", { count: "exact", head: true })
      .eq("conference_id", confId);

    // Ignorar respuestas viejas (otra conferencia o consulta más reciente)
    if (token !== countToken || confId !== activeConferenceId) return;
    if (error || count === null) return;
    countEl.textContent = String(count);
  }

  // ---------- Inicialización desde el orquestador ----------
  section.addEventListener("kiosk:init", ((e: CustomEvent) => {
    const conf = e.detail;
    activeConferenceId = conf.conference_id;

    document.getElementById("kiosk-title")!.textContent = conf.conference_name;
    countEl.textContent = "–"; // nunca mostrar el número de otra conferencia
    codeInput.value = "";
    reader.value = "";

    setIdle();
    focusReader(true);
    refreshCount(conf.conference_id);
  }) as EventListener);

  document.getElementById("btn-end")?.addEventListener("click", () => {
    stopPhoneNfc();
    activeConferenceId = null;
    countToken++; // invalida consultas en vuelo
    document.dispatchEvent(new Event("sirae:end-kiosk"));
  });

  // ---------- Entrada de códigos ----------
  // Lector USB: termina con Enter
  reader.addEventListener("keydown", (e) => {
    if (e.key !== "Enter") return;
    e.preventDefault();
    const code = reader.value;
    reader.value = "";
    submitCode(code);
  });

  // Código manual: se envía y el foco vuelve al lector
  manualForm.addEventListener("submit", (e) => {
    e.preventDefault();
    const code = codeInput.value;
    codeInput.value = "";
    submitCode(code);
    focusReader(true);
  });

  // Cola: si pasan varias credenciales seguidas se procesan en orden
  let queue: Promise<void> = Promise.resolve();

  function submitCode(raw: string) {
    const code = raw.trim();
    if (!code || activeConferenceId == null) return;
    const confId = activeConferenceId;
    queue = queue.then(() => processAttendance(confId, code)).catch(() => {});
  }

  async function processAttendance(confId: number, code: string) {
    // Mostrar estado de carga justo antes de hacer la petición
    setFeedback("loading", "Consultando...", "Ya puedes retirar tu credencial");

    const { data, error } = await supabase.rpc("register_attendance", {
      p_conference_id: confId,
      p_code: code,
    });

    if (confId !== activeConferenceId) return; // el usuario ya salió de esa conferencia

    if (error || !data) {
      return setFeedback("error", "Error de conexión", "Vuelve a intentarlo");
    }

    switch (data.status) {
      case "registered":
        setFeedback("success", "Asistencia Registrada", data.full_name || "Alumno sin cuenta", data.student_code);
        countEl.textContent = String((Number(countEl.textContent) || 0) + 1); // respuesta inmediata
        refreshCount(confId); // y se confirma contra la BD
        break;
      case "duplicate":
        setFeedback("warn", "Ya registrado", "Esta credencial ya pasó asistencia hoy", data.student_code);
        break;
      default:
        setFeedback("error", "Acceso denegado", String(data.status));
    }
  }

  // ---------- Feedback visual ----------
  function setFeedback(state: "idle" | "loading" | "success" | "warn" | "error", title: string, subtitle: string, code = "") {
    clearTimeout(resetTimer);

    const states = {
      idle: {
        border: "border-border-main",
        bg: "bg-white",
        iconBg: "bg-turq-pale text-navy shadow-[0_10px_24px_rgba(0,174,204,0.14)]",
        icon: `<svg viewBox="0 0 48 48" class="size-11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6.5" y="10" width="25" height="28" rx="5"></rect><path d="M12 18h14M12 23h8M12 29h6"></path><path d="M34 17c4.5 4 4.5 10 0 14M38 12c7 6 7 18 0 24"></path></svg>`,
        text: "text-navy",
      },
      loading: {
        border: "border-turq-acc/50",
        bg: "bg-turq-pale/50",
        iconBg: "bg-turq-acc text-white shadow-[0_10px_24px_rgba(0,174,204,0.3)]",
        icon: `<svg viewBox="0 0 24 24" class="size-11 animate-spin" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>`,
        text: "text-navy",
      },
      success: {
        border: "border-green/30",
        bg: "bg-green-pale/70",
        iconBg: "bg-green text-white shadow-[0_10px_24px_rgba(64,206,2,0.18)]",
        icon: `<svg viewBox="0 0 48 48" class="size-11" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="17"></circle><path d="m15.5 24.5 5.5 5.5 11.5-12"></path></svg>`,
        text: "text-navy",
      },
      warn: {
        border: "border-[#f5a623]/50",
        bg: "bg-[#fff9e6]",
        iconBg: "bg-[#f5a623] text-white shadow-[0_10px_24px_rgba(245,166,35,0.2)]",
        icon: `<svg viewBox="0 0 48 48" class="size-11" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M24 6.5 43 39H5L24 6.5Z"></path><path d="M24 18v9M24 33.5h.02"></path></svg>`,
        text: "text-[#9a6700]",
      },
      error: {
        border: "border-[#e02424]/35",
        bg: "bg-[#fff1f1]",
        iconBg: "bg-[#e02424] text-white shadow-[0_10px_24px_rgba(224,36,36,0.17)]",
        icon: `<svg viewBox="0 0 48 48" class="size-11" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="17"></circle><path d="m18 18 12 12M30 18 18 30"></path></svg>`,
        text: "text-[#b91c1c]",
      },
    };

    const s = states[state];
    feedbackBox.className = `relative flex w-full max-w-4xl flex-col items-center gap-5 overflow-hidden rounded-[1.75rem] border p-6 shadow-custom-lg transition-all duration-300 sm:flex-row sm:gap-7 sm:p-9 ${s.border} ${s.bg}`;
    feedbackIcon.className = `relative z-10 flex size-20 shrink-0 items-center justify-center rounded-2xl sm:size-24 ${s.iconBg}`;
    feedbackIcon.innerHTML = s.icon;
    feedbackTitle.className = `font-stellalabs text-2xl font-bold leading-tight tracking-tight sm:text-3xl ${s.text}`;
    feedbackTitle.textContent = title;

    feedbackSubtitle.innerHTML = code
      ? `<span class="block break-words text-lg font-bold text-navy sm:text-xl">${esc(subtitle)}</span><span class="mt-1 inline-block font-mono text-xs tracking-wide text-text-muted">${esc(code)}</span>`
      : `<span class="break-words text-text-mid">${esc(subtitle)}</span>`;

    if (state !== "idle" && state !== "loading") resetTimer = window.setTimeout(setIdle, 2500);
  }

  function setIdle() {
    setFeedback("idle", "Esperando credencial", "Acerca tu credencial al lector");
  }

  // ---------- NFC del celular (Web NFC: solo Chrome en Android, HTTPS) ----------
  const nfcSupported = "NDEFReader" in window && window.isSecureContext;
  let nfcAbort: AbortController | null = null;
  let lastPhoneCode = "";
  let lastPhoneAt = 0;

  /**
   * Convierte el serialNumber de Web NFC (ej. "04:a1:b2:c3") al formato que
   * entrega tu lector USB. AJUSTA ESTA FUNCIÓN al formato real guardado en BD.
   * Por defecto: hexadecimal en mayúsculas, sin ":".
   *
   * Si tu lector USB entrega el UID en decimal (muy común), usa por ejemplo:
   *   const bytes = serial.split(":").map((h) => parseInt(h, 16));
   *   return String(parseInt(bytes.reverse().map((b) => b.toString(16).padStart(2, "0")).join(""), 16));
   */
  function formatUid(serial: string): string {
    return serial.replace(/:/g, "").toUpperCase();
  }

  function paintNfcButton(active: boolean) {
    btnNfcPhone.textContent = active ? "NFC del celular activo · Desactivar" : "Usar NFC del celular";
    btnNfcPhone.dataset.active = String(active);
  }

  async function startPhoneNfc() {
    try {
      const ndef = new (window as any).NDEFReader();
      nfcAbort = new AbortController();

      ndef.addEventListener("reading", (ev: any) => {
        if (!ev.serialNumber) return;
        const code = formatUid(ev.serialNumber);
        // Android dispara "reading" varias veces mientras la tarjeta está pegada
        const now = Date.now();
        if (code === lastPhoneCode && now - lastPhoneAt < 3000) return;
        lastPhoneCode = code;
        lastPhoneAt = now;
        submitCode(code);
      });
      ndef.addEventListener("readingerror", () => {
        setFeedback("error", "No se pudo leer", "Acerca de nuevo la credencial al celular");
      });

      await ndef.scan({ signal: nfcAbort.signal });
      paintNfcButton(true);
      setFeedback("idle", "NFC del celular activo", "Acerca la credencial a la parte trasera del celular");
    } catch (err: any) {
      nfcAbort = null;
      paintNfcButton(false);
      setFeedback(
        "error",
        "NFC no disponible",
        err?.name === "NotAllowedError" ? "Permite el acceso a NFC en el navegador" : "Activa el NFC en los ajustes del celular",
      );
    }
  }

  function stopPhoneNfc() {
    nfcAbort?.abort();
    nfcAbort = null;
    paintNfcButton(false);
  }

  if (nfcSupported) {
    btnNfcPhone.hidden = false;
    // scan() exige un gesto del usuario, por eso se activa con un botón
    btnNfcPhone.addEventListener("click", () => (nfcAbort ? stopPhoneNfc() : startPhoneNfc()));
  }
</script>