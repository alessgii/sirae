---
---

<header class="sticky top-0 z-40 w-full border-b border-border-main/80 bg-white/90 shadow-[0_8px_30px_rgba(13,43,78,0.045)] backdrop-blur-xl transition-colors duration-200">
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 md:px-8">
    <a href="/" class="group flex min-w-0 items-center gap-3.5 rounded-xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-turq-acc/20" aria-label="SIRAE, ir al inicio">
      <div class="relative flex size-11 shrink-0 items-center justify-center overflow-hidden rounded-2xl ring-1 ring-white/30 transition-transform duration-200 group-hover:scale-[1.03]">
        <img src="/favicon.svg" alt="" class="size-full object-contain" />
        <span class="pointer-events-none absolute inset-0 rounded-2xl ring-1 ring-inset ring-white/15"></span>
      </div>
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <h1 class="font-stellalabs text-lg font-bold leading-none tracking-tight text-navy sm:text-xl">SIRAE</h1>
        </div>
        <p class="mt-1.5 truncate text-[10px] font-medium tracking-wide text-text-muted sm:text-[11px]">Sistema de registro <span class="mx-1 text-border-main">·</span>StellaLabs</p>
      </div>
    </a>

    <!-- Acceso de usuario -->
    <div class="flex shrink-0 items-center gap-3">
      <div id="auth-slot-desktop" class="relative flex min-w-0 items-center justify-end">
        <a
          href="/login"
          id="btn-login-desktop"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-border-main bg-white px-3.5 py-2.5 text-xs font-bold text-navy shadow-sm transition-all hover:border-turq-acc hover:bg-turq-pale sm:px-4 sm:text-sm focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-turq-acc/20"
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 17l5-5-5-5M15 12H3"></path><path d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"></path>
          </svg>
          Iniciar sesión
        </a>

        <div id="user-menu-desktop" class="relative hidden items-center">
          <button
            id="avatar-btn-desktop"
            type="button"
            aria-label="Abrir menú de usuario"
            aria-haspopup="menu"
            aria-expanded="false"
            class="flex items-center gap-2 rounded-full border border-border-main bg-white p-1 pr-2 transition-all hover:border-turq-acc hover:shadow-sm focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-turq-acc/20"
          >
            <img id="avatar-img-desktop" src="" alt="Avatar de usuario" class="size-9 rounded-full bg-turq-pale object-cover ring-1 ring-border-lt" />
            <svg viewBox="0 0 24 24" class="mr-0.5 size-4 text-text-muted transition-transform" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m7 10 5 5 5-5"></path>
            </svg>
          </button>

          <div
            id="user-dropdown"
            role="menu"
            aria-label="Menú de usuario"
            class="invisible pointer-events-none absolute right-0 top-full z-50 mt-3 w-64 translate-y-1 rounded-2xl border border-border-main/80 bg-white/95 p-2 opacity-0 shadow-[0_20px_55px_rgba(13,43,78,0.16)] backdrop-blur-xl transition-all duration-200"
          >
            <div class="rounded-xl bg-bg-main/80 px-3.5 py-3.5">
              <p class="mb-2 text-[9px] font-bold uppercase tracking-[0.18em] text-text-muted">Cuenta activa</p>
              <p id="user-display-name" class="truncate text-sm font-bold text-navy"></p>
              <div class="mt-2 flex items-center justify-between gap-2">
                <span id="user-display-code" class="truncate font-mono text-[10px] font-semibold text-text-muted"></span>
                <span id="user-display-role" class="shrink-0 rounded-full border border-turq-acc/15 bg-turq-pale px-2 py-1 font-mono text-[9px] font-bold uppercase tracking-wider text-navy"></span>
              </div>
            </div>

            <button id="btn-logout-desktop" type="button" role="menuitem" class="mt-2 flex w-full items-center gap-2.5 rounded-xl px-3.5 py-3 text-left text-xs font-bold text-[#b91c1c] transition-colors hover:bg-[#fff1f1] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#e02424]/20">
              <span class="flex size-8 items-center justify-center rounded-lg bg-[#fff1f1]" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 17l5-5-5-5M15 12H3"></path><path d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"></path>
                </svg>
              </span>
              Cerrar sesión
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { supabase } from "../../lib/supabase";

  const btnLoginDesktop = document.getElementById("btn-login-desktop");
  const userMenuDesktop = document.getElementById("user-menu-desktop");
  const avatarBtnDesktop = document.getElementById("avatar-btn-desktop");
  const avatarImgDesktop = document.getElementById("avatar-img-desktop") as HTMLImageElement;
  const userDropdown = document.getElementById("user-dropdown");
  const userDisplayName = document.getElementById("user-display-name");
  const userDisplayCode = document.getElementById("user-display-code");
  const userDisplayRole = document.getElementById("user-display-role");
  const btnLogoutDesktop = document.getElementById("btn-logout-desktop");

  const getAvatarUrl = (seed: string) => `https://api.dicebear.com/9.x/lorelei/svg?seed=${encodeURIComponent(seed)}&backgroundColor=e8f1fb`;

  const setUserDropdownOpen = (open: boolean) => {
    userDropdown?.classList.toggle("invisible", !open);
    userDropdown?.classList.toggle("pointer-events-none", !open);
    userDropdown?.classList.toggle("opacity-0", !open);
    userDropdown?.classList.toggle("translate-y-1", !open);
    userDropdown?.classList.toggle("translate-y-0", open);
    avatarBtnDesktop?.setAttribute("aria-expanded", String(open));
  };

  avatarBtnDesktop?.addEventListener("click", (e) => {
    e.stopPropagation();
    setUserDropdownOpen(userDropdown?.classList.contains("invisible") ?? true);
  });
  document.addEventListener("click", () => setUserDropdownOpen(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setUserDropdownOpen(false);
  });

  const showUserAuth = async (user: any) => {
    const { data: profile } = await supabase.from("profiles").select("role, student_code, username").eq("id", user.id).single();
    
    if (btnLoginDesktop) btnLoginDesktop.style.display = "none";
    if (userMenuDesktop) {
      userMenuDesktop.classList.remove("hidden");
      userMenuDesktop.style.display = "flex";
    }

    const username = profile?.username || user.email?.split("@")[0] || "User";
    if (avatarImgDesktop) avatarImgDesktop.src = getAvatarUrl(username);
    if (userDisplayName) userDisplayName.textContent = `@${username}`;
    if (userDisplayCode) userDisplayCode.textContent = profile?.student_code || "";
    if (userDisplayRole) userDisplayRole.textContent = profile?.role || "student";
  };

  const showGuestAuth = () => {
    if (btnLoginDesktop) btnLoginDesktop.style.display = "";
    if (userMenuDesktop) userMenuDesktop.style.display = "none";
  };

  const syncAuthState = async () => {
    const { data: { session } } = await supabase.auth.getSession();
    session?.user ? await showUserAuth(session.user) : showGuestAuth();
  };

  btnLogoutDesktop?.addEventListener("click", async () => {
    await supabase.auth.signOut();
    window.location.href = "/login";
  });

  supabase.auth.onAuthStateChange((_event, session) => session?.user ? showUserAuth(session.user) : showGuestAuth());
  syncAuthState();
</script>
