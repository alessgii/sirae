---
// src/components/sirae/CreateConferenceModal.astro
---

<dialog
  id="create-modal"
  class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-custom border border-border-main bg-white p-0 text-text-main shadow-custom-lg backdrop:bg-navy/40 backdrop:backdrop-blur-sm open:animate-fade-in-up"
>
  <form id="create-form" method="dialog" class="p-6 sm:p-8" novalidate>
    <div class="mb-6 flex items-start justify-between gap-4">
      <div>
        <h2 class="font-poppins text-xl font-bold text-navy">Nueva conferencia</h2>
        <p class="mt-1 text-sm text-text-muted">Configura los horarios para la apertura del kiosko.</p>
      </div>
      <button id="modal-close" type="button" class="text-text-muted hover:text-navy transition-colors text-2xl leading-none" aria-label="Cerrar">&times;</button>
    </div>

    <div class="space-y-4">
      <!-- Input Institucional -->
      <div>
        <label for="f-name" class="mb-1.5 block text-sm font-semibold text-text-main">Nombre de la conferencia</label>
        <input id="f-name" name="conference_name" type="text" required maxlength="150" autocomplete="off"
          class="w-full rounded-custom border border-border-main bg-bg-main px-4 py-2.5 text-sm text-navy focus:border-turq-acc focus:bg-white focus:outline-none focus:ring-2 focus:ring-turq-acc/20 transition-all" />
      </div>
      
      <div>
        <label for="f-speaker" class="mb-1.5 block text-sm font-semibold text-text-main">Ponente</label>
        <input id="f-speaker" name="speaker_name" type="text" required maxlength="150" autocomplete="off"
          class="w-full rounded-custom border border-border-main bg-bg-main px-4 py-2.5 text-sm text-navy focus:border-turq-acc focus:bg-white focus:outline-none focus:ring-2 focus:ring-turq-acc/20 transition-all" />
      </div>

      <div>
        <label for="f-site" class="mb-1.5 block text-sm font-semibold text-text-main">Sede</label>
        <input id="f-site" name="conference_site" type="text" required maxlength="100" autocomplete="off" value="Sala Rubén Villa Señor (CCJAM)"
          class="w-full rounded-custom border border-border-main bg-bg-main px-4 py-2.5 text-sm text-navy focus:border-turq-acc focus:bg-white focus:outline-none focus:ring-2 focus:ring-turq-acc/20 transition-all" />
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="f-start" class="mb-1.5 block text-sm font-semibold text-text-main">Inicia</label>
          <input id="f-start" name="starts" type="datetime-local" required
            class="w-full rounded-custom border border-border-main bg-bg-main px-4 py-2.5 text-sm text-navy focus:border-turq-acc focus:bg-white focus:outline-none focus:ring-2 focus:ring-turq-acc/20 transition-all" />
        </div>
        <div>
          <label for="f-end" class="mb-1.5 block text-sm font-semibold text-text-main">Termina</label>
          <input id="f-end" name="ends" type="datetime-local" required
            class="w-full rounded-custom border border-border-main bg-bg-main px-4 py-2.5 text-sm text-navy focus:border-turq-acc focus:bg-white focus:outline-none focus:ring-2 focus:ring-turq-acc/20 transition-all" />
        </div>
        <div>
          <label for="f-before" class="mb-1.5 block text-sm font-semibold text-text-main">Abrir registro (min antes)</label>
          <input id="f-before" name="before" type="number" min="0" max="720" value="30" required
            class="w-full rounded-custom border border-border-main bg-bg-main px-4 py-2.5 text-sm text-navy focus:border-turq-acc focus:bg-white focus:outline-none focus:ring-2 focus:ring-turq-acc/20 transition-all" />
        </div>
        <div>
          <label for="f-after" class="mb-1.5 block text-sm font-semibold text-text-main">Cerrar (min después)</label>
          <input id="f-after" name="after" type="number" min="0" max="720" value="15" required
            class="w-full rounded-custom border border-border-main bg-bg-main px-4 py-2.5 text-sm text-navy focus:border-turq-acc focus:bg-white focus:outline-none focus:ring-2 focus:ring-turq-acc/20 transition-all" />
        </div>
      </div>
      
      <p id="f-error" class="hidden rounded-custom border border-[#e02424]/30 bg-[#fde8e8] px-4 py-2.5 text-sm text-[#c81e1e] font-semibold"></p>
    </div>

    <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end border-t border-border-main pt-5">
      <button id="modal-cancel" type="button" class="rounded-custom px-6 py-2.5 text-sm font-bold text-text-mid transition hover:bg-bg-main">
        Cancelar
      </button>
      <button id="modal-submit" type="submit" class="rounded-custom bg-navy px-6 py-2.5 text-sm font-bold text-white transition hover:bg-navy-mid hover:shadow-md disabled:opacity-50">
        Crear conferencia
      </button>
    </div>
  </form>
</dialog>

<script>
  import { supabase } from "../../lib/supabase";

  const modal = document.getElementById("create-modal") as HTMLDialogElement;
  const form = document.getElementById("create-form") as HTMLFormElement;
  const errBox = document.getElementById("f-error");

  // Escuchar botón externo para abrir (definido en ConferenceSelect.astro)
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest("#btn-open-modal")) {
      form.reset();
      if(errBox) errBox.hidden = true;
      modal.showModal();
    }
  });

  // Cerrar Modal
  const closeModal = () => modal.close();
  document.getElementById("modal-close")?.addEventListener("click", closeModal);
  document.getElementById("modal-cancel")?.addEventListener("click", closeModal);

  // Lógica de Envío
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (errBox) errBox.hidden = true;

    const formData = new FormData(form);
    const start = new Date(String(formData.get("starts")));
    const end = new Date(String(formData.get("ends")));
    const before = Number(formData.get("before"));
    const after = Number(formData.get("after"));

    if (end <= start) return showError("La hora de término debe ser posterior al inicio.");

    const regStart = new Date(start.getTime() - before * 60000);
    const regEnd = new Date(start.getTime() + after * 60000);

    const submitBtn = document.getElementById("modal-submit") as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = "Creando...";

    const { error } = await supabase.from("conferences").insert({
      conference_name: String(formData.get("conference_name")).trim(),
      speaker_name: String(formData.get("speaker_name")).trim(),
      conference_site: String(formData.get("conference_site")).trim(),
      conference_starts_at: start.toISOString(),
      register_starts_at: regStart.toISOString(),
      register_ends_at: regEnd.toISOString(),
      conference_ends_at: end.toISOString(),
    });

    submitBtn.disabled = false;
    submitBtn.textContent = "Crear conferencia";

    if (error) {
      showError("No se pudo crear. Verifica tu conexión.");
      return;
    }

    closeModal();
    // 📢 Avisar al componente selector que debe recargar la lista
    document.getElementById("view-select")?.dispatchEvent(new Event("select:refresh"));
  });

  function showError(msg: string) {
    if (errBox) {
      errBox.textContent = msg;
      errBox.hidden = false;
    }
  }
</script>